{
  "name": "mineradio",
  "productName": "Mineradio",
  "version": "2.0.2",
  "description": "Windows 沉浸式音乐播放器，融合桌面模式、歌词舞台、粒子视觉和 3D 歌单架。",
  "author": "Mineradio",
  "license": "GPL-3.0-only",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "test": "node tests/kugou-lite-account.test.js && node tests/kugou-lite-playlist-protocol.test.js && node tests/kugou-single-account-ui.test.js && node tests/kugou-playback-resilience.test.js && node --test tests/kugou-lyric-translation.test.js tests/kugou-lyrics-renderer-policy.test.js tests/kugou-only-source-policy.test.js tests/kugou-only-playback-policy.test.js tests/online-music-route-policy.test.js && npm run test:graphics-startup",
    "start": "electron .",
    "build:win": "electron-builder --win nsis --publish never && npm run test:installer-manifest && npm run test:packed-runtime",
    "build:win:dir": "electron-builder --win dir",
    "build:win:internal-beta": "electron-builder --config electron-builder.internal-beta.json --win nsis --publish never",
    "test:installer-manifest": "node --test tests/installer-manifest.test.js",
    "test:packed-runtime": "node --test tests/packed-runtime-dependencies.test.js",
    "test:graphics-startup": "node --test tests/graphics-startup-policy.test.js tests/graphics-runtime.test.js tests/graphics-bootstrap.test.js tests/graphics-startup-wiring.test.js",
    "release:audit": "node scripts/audit-release-privacy.js dist/win-unpacked/resources/app",
    "release:checksum": "node scripts/create-release-checksum.js dist/super_mineradio_s.exe"
  },
  "build": {
    "appId": "com.mineradio.desktop",
    "productName": "Mineradio",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.js",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "build/**/*",
      "cuefield/**/*",
      "server.js",
      "online-music-policy.js",
      "*-api.js",
      "kugou-account-bridge.js",
      "qishui-audio-decryptor/**/*",
      "dj-analyzer.js",
      "LICENSE",
      "NOTICE.md",
      "docs/THIRD_PARTY_PORTS.md",
      "package.json",
      "!desktop/wallpaper-preload.js",
      "!public/wallpaper.html",
      "!public/index.*.html",
      "public/index.html"
    ],
    "asar": false,
    "win": {
      "executableName": "Mineradio",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mineradio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": null,
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "artifactName": "super_mineradio_s.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Super-55",
        "repo": "super_music_mineradio_basic"
      }
    ]
  },
  "mineradio": {
    "update": {
      "provider": "github",
      "owner": "Super-55",
      "repo": "super_music_mineradio_basic",
      "preview": true,
      "preferMirrors": true,
      "mirrors": [
        "https://gh.llkk.cc/",
        "https://ghfast.top/",
        "https://gh-proxy.com/"
      ]
    }
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "mpg123-decoder": "^1.0.3",
    "NeteaseCloudMusicApi": "^4.32.0",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "axios": "1.18.1",
    "body-parser": "1.20.6",
    "music-metadata": "11.14.0"
  },
  "devDependencies": {
    "acorn": "^8.15.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "pe-library": "^0.4.1",
    "rcedit": "^5.0.2"
  }
}
